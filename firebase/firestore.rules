rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isStaff() {
      return request.auth != null;
    }

    function validCallEvent() {
      return request.resource.data.type in ['number', 'name']
        && request.resource.data.value is string
        && request.resource.data.value.size() > 0
        && request.resource.data.value.size() <= 100
        && (request.resource.data.title is string || request.resource.data.title == null)
        && request.resource.data.calledBy == request.auth.uid;
    }

    match /queues/{docId} {
      allow read: if true;
      allow create: if isStaff()
        && request.resource.data.queueNumber is string
        && request.resource.data.queueNumber.size() > 0
        && request.resource.data.queueNumber.size() <= 10
        && request.resource.data.status in ['waiting', 'called', 'done', 'skipped']
        && request.resource.data.queueDate is string
        && request.resource.data.queueDate.matches('\\d{4}-\\d{2}-\\d{2}');
      allow update: if isStaff()
        && request.resource.data.status in ['waiting', 'called', 'done', 'skipped'];
      allow delete: if false;
    }

    match /call_events/{docId} {
      allow read: if true;
      allow create: if isStaff() && validCallEvent();
      allow update, delete: if false;
    }
  }
}
